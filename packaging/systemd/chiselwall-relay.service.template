[Unit]
Description=ChiselWall relay (routes-only, no knowledge stored)
Documentation=https://github.com/douhe66/ChiselWall-
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=__SERVICE_USER__
Group=__SERVICE_USER__
WorkingDirectory=__INSTALL_DIR__
ExecStart=__INSTALL_DIR__/start-relay.sh --config __CONFIG__ --host 0.0.0.0 --port __PORT__ --log-file /var/log/chiselwall/relay.log
Restart=always
RestartSec=5
StartLimitIntervalSec=0
KillSignal=SIGTERM
TimeoutStopSec=15
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
